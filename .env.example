# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill the real values.
# NEVER commit .env — it holds private keys.
# ---------------------------------------------------------------------------

# --- Google Sheet ----------------------------------------------------------
# Sheet ID = the long id in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=

# Tab name that holds the article rows
SHEET_TAB=CONTENT_QUEUE

# From the service account JSON: "client_email"
GOOGLE_CLIENT_EMAIL=

# From the service account JSON: "private_key".
# Keep it on ONE line, inside double quotes, with the \n exactly as they are.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Optional fallback: path to the service account JSON file.
# Only used when GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY are empty.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# --- Google Ads (via proxy) -------------------------------------------------
# No client id / client secret / developer token needed — the proxy handles auth.

# Proxy base URL; "/v24/customers/..." is appended automatically.
ADS_PROXY_BASE_URL=https://secure.dataram.workers.dev/api
ADS_API_VERSION=v24

# Sent as the "x-user-refresh-token" header
GOOGLE_ADS_REFRESH_TOKEN=
# Account where campaigns are created, digits only (1234567890)
GOOGLE_ADS_CUSTOMER_ID=
# Manager (MCC) account id, digits only. Only needed for MCC sub-accounts.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Safety ----------------------------------------------------------------
# true  = nothing is sent to Google Ads, everything is only printed (safe)
# false = real PAUSED campaigns are created
DRY_RUN=true
